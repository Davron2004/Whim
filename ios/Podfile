# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported
prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'Whim' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )
    # react_native_post_install raises every pod target to React Native's minimum iOS but skips
    # resource-bundle targets; react-native-svg's RNSVGFilters bundle declares 12.4, which Xcode
    # refuses. Raise those too, never lowering one.
    installer.target_installation_results.pod_target_installation_results.each_value do |result|
      result.resource_bundle_targets.each do |bundle|
        bundle.build_configurations.each do |build|
          current = build.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] || min_ios_version_supported
          build.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = [min_ios_version_supported.to_f, current.to_f].max.to_s
        end
      end
    end
  end
end
