# OSX
.DS_Store

# Xcode
ios/build/
*.pbxuser
!default.pbxuser
*.mode1v3
!default.mode1v3
*.mode2v3
!default.mode2v3
*.perspectivev3
!default.perspectivev3
xcuserdata
*.xccheckout
*.moved-aside
DerivedData
*.hmap
*.ipa
*.xcuserstate
**/.xcode.env.local

# Android/IntelliJ
android/**/build/
.idea
.gradle
local.properties
*.iml
*.hprof
.cxx/
*.keystore
!debug.keystore
.kotlin/

# node.js
node_modules/
npm-debug.log
yarn-error.log

# fastlane
# It is recommended to not store the screenshots in the git repo. Instead, use fastlane to re-generate the
# screenshots whenever they are needed.
# For more information about the recommended setup visit:
# https://docs.fastlane.tools/best-practices/source-control/

**/fastlane/report.xml
**/fastlane/Preview.html
**/fastlane/screenshots
**/fastlane/test_output

# Bundle artifact
*.jsbundle

# Ruby / CocoaPods
**/Pods/
/vendor/bundle/

# iOS bring-up evidence (simulator screenshots); local only
/.ios-bringup/

# Temporary files created by Metro to check the health of the file watcher
.metro-health-check*

# Release signing keys and store publisher credentials (~/.config/whim/, docs/release/mobile.md
# — never committed here)
*.jks
*.p8
play-publisher*.json

# testing
/coverage

# Yarn
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# Whim project-specific generated files & local settings
# (build/*.mjs scripts are SOURCE and tracked; only build/generated/ is output)
/build/generated/
invariants/sandbox-isolation/.build-pages/
invariants/sandbox-isolation/bridge/.build-pages/
src/host/launcher/test/.deliver-pages/
src/runtime/generated/
.obsidian/
.claude/settings.local.json
.claude/fixloop/*.log
.claude/fixloop/wip-*.md
.claude/fixloop/grants/
.claude/fixloop/owners/
*.tmp.mjs
# greenBy phased-TDD signal: the dispatcher writes checks/test/.phase into each chain's
# worktree before dispatching; never committed, so gate-full.sh + CI run the suite STRICT.
checks/test/.phase

# Harness server: durable per-device token counter (the only server state) + local secrets
server/.data/
# Dev-only device log sink (WHIM_DEV_LOG_SINK=1): `npm run whim:logs` tails it. Never committed.
server/.logs/
.env

# Corpus-eval CLI: local run reports (the CLI's default --out; never a committed artifact —
# docs/evals.md). The visible eval set + its Tier-B specs live at evals/sets/visible/ and stay
# tracked; this is scratch OUTPUT only.
evals/.reports/

# Demo pipeline (demo/): raw Maestro takes and rendered cuts are OUTPUT, never committed —
# the flows (demo/android/flows/), the cut/voiceover tools (demo/tools/) and demo/README.md stay tracked.
demo/out/
demo/raw/

# Graphify knowledge graph: local dev aid only (post-commit hook regenerates it from the
# manifest, so a tracked copy would churn every commit). The skill (.agents/skills/graphify/)
# and .graphifyignore ARE committed; rebuild anytime with `graphify extract . --code-only`.
graphify-out/
