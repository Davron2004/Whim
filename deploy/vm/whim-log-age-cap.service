# Caps the age of the container log lines on the VM (deploy/vm/log-age-cap.sh): trims rotated logs,
# recreates a compose service whose active log holds a line past the cap.
# Started daily by whim-log-age-cap.timer; installed by deploy/vm/bootstrap.sh.
[Unit]
Description=Whim container log age cap
After=docker.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/whim-log-age-cap.sh
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=-/var/lib/docker/containers
