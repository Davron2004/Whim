# Front proxy for Whim (design D17, D21). Both hostnames come from the caddy service's environment,
# which deploy/compose.yaml takes from /opt/whim/.env. Caddy redirects HTTP to HTTPS and keeps its
# certificates under /data on the persistent disk. Neither site keeps an access log.

# Every line Caddy still writes (errors, reverse-proxy aborts) ships to Cloud Logging, so the default
# logger drops the request's headers (X-Whim-Device among them) and the client's address and port.
{
	log default {
		format filter {
			wrap json
			fields {
				request>headers delete
				request>remote_ip delete
				request>remote_port delete
				request>client_ip delete
				resp_headers delete
			}
		}
	}
}

# The API: stream-safe reverse proxy to the server, with no compression and no file serving.
{$WHIM_API_HOST} {
	request_body {
		max_size 2MB
	}
	reverse_proxy whim-server:8787 {
		flush_interval -1
	}
}

# The pages host: the published static site and nothing else. Routes rewrite internally to flat
# files, so no answer is a redirect (Apple and Android refuse an association file behind one).
# /assets/* serves the pages' self-hosted fonts as published; font-src 'self' lets only those load.
# The /beta form posts to the API site's /beta/signup, which answers with a redirect back here.
{$WHIM_WEB_HOST} {
	root * /srv/site/current
	header {
		Content-Security-Policy "default-src 'none'; style-src 'unsafe-inline'; img-src 'self'; font-src 'self'"
		X-Content-Type-Options nosniff
	}

	handle /.well-known/apple-app-site-association {
		header Content-Type application/json
		file_server {
			disable_canonical_uris
		}
	}
	handle /.well-known/assetlinks.json {
		header Content-Type application/json
		file_server {
			disable_canonical_uris
		}
	}
	handle /privacy {
		rewrite * /privacy.html
		file_server {
			disable_canonical_uris
		}
	}
	handle /privacy/v1 {
		rewrite * /privacy-v1.html
		file_server {
			disable_canonical_uris
		}
	}
	handle /terms {
		rewrite * /terms.html
		file_server {
			disable_canonical_uris
		}
	}
	handle /fr/privacy {
		rewrite * /fr/privacy.html
		file_server {
			disable_canonical_uris
		}
	}
	handle /fr/terms {
		rewrite * /fr/terms.html
		file_server {
			disable_canonical_uris
		}
	}
	handle /support {
		rewrite * /support.html
		file_server {
			disable_canonical_uris
		}
	}
	handle /beta {
		rewrite * /beta.html
		file_server {
			disable_canonical_uris
		}
	}
	handle /beta/thanks {
		rewrite * /beta-thanks.html
		file_server {
			disable_canonical_uris
		}
	}
	handle /beta/retry {
		rewrite * /beta-retry.html
		file_server {
			disable_canonical_uris
		}
	}
	handle /assets/* {
		file_server {
			disable_canonical_uris
		}
	}
	handle /a/* {
		rewrite * /app-link.html
		file_server {
			disable_canonical_uris
		}
	}
	handle {
		rewrite * /not-found.html
		file_server {
			status 404
			disable_canonical_uris
		}
	}
}
