# Capacity profile "standard" (design D25): the everyday VM. It sets no server limit, so
# server/src/config.ts stays the one source of the defaults. deploy/deploy.sh applies the profile
# whose machine type equals the VM's.
WHIM_PROFILE_MACHINE_TYPE=e2-standard-2
WHIM_SERVER_MEM_LIMIT=6g
WHIM_SERVER_SHM_SIZE=1gb
