# Capacity profile "event" (design D25): demo night. Resize to it with
# `deploy/resize.sh --profile event` and back with `--profile standard` afterwards.
WHIM_PROFILE_MACHINE_TYPE=e2-standard-8
WHIM_SERVER_MEM_LIMIT=16g
WHIM_SERVER_SHM_SIZE=3gb
WHIM_MAX_CONCURRENT_GENERATIONS=15
WHIM_SYNTHRUN_CONCURRENCY=6
WHIM_MAX_CONCURRENT_UNARY=32
