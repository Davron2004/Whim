# The API uptime check (developer-observability D10), applied by deploy/provision.sh against
# https://WHIM_API_HOST. Values are literal (deploy/lib.sh reads them). Regions are gcloud's
# `monitoring uptime --regions` names; at least three.
DISPLAY_NAME=Whim API healthz
CHECK_PATH=/healthz
PERIOD_MINUTES=5
TIMEOUT_SECONDS=10
REGIONS=usa-virginia,usa-oregon,europe
MATCHER_CONTENT="ok":true
