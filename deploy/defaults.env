# Committed, non-secret deploy values every operator shares (design D20, D24). The deploy scripts
# load this file first, then ~/.config/whim/deploy.env, then the process environment; later sources
# win. WHIM_API_HOST must stay "api." followed by WHIM_WEB_HOST.
WHIM_GCP_PROJECT=anycognition-whim
WHIM_GCP_REGION=northamerica-northeast1
WHIM_GCP_ZONE=northamerica-northeast1-a
WHIM_STATIC_IP=34.118.191.193
WHIM_API_HOST=api.whim.anycognition.ca
WHIM_WEB_HOST=whim.anycognition.ca
