# Names only. Copy to ~/.config/whim/deploy.env and fill in (design D24). None of these has a
# committed default. The two store URLs are optional. So are the two minimum builds: unset is 0,
# which serves every build (docs/deploy.md, "Minimum supported build"). WHIM_USAGE_IDLE_DAYS is
# optional too: unset keeps the server's own default, and deploy refuses a value above the
# disclosure manifest's maximum for usage records. The last three are read by provision.sh only,
# which requires them: the alert address, the billing account id and the monthly budget in whole USD.
WHIM_SUPPORT_EMAIL=
WHIM_ENGINEER_MODEL=
WHIM_REWRITE_MODEL=
WHIM_CLARIFY_MODEL=
WHIM_SUMMARY_MODEL=
WHIM_PLAN_MODEL=
WHIM_REPAIR_MODEL=
WHIM_ENGINEER_REASONING=
WHIM_REWRITE_REASONING=
WHIM_CLARIFY_REASONING=
WHIM_SUMMARY_REASONING=
WHIM_PLAN_REASONING=
WHIM_REPAIR_REASONING=
WHIM_PROVIDER_SORT=
WHIM_MIN_BUILD_IOS=
WHIM_MIN_BUILD_ANDROID=
WHIM_USAGE_IDLE_DAYS=
WHIM_APP_STORE_URL=
WHIM_PLAY_STORE_URL=
WHIM_ALERT_EMAIL=
WHIM_BILLING_ACCOUNT=
WHIM_MONTHLY_BUDGET_USD=
