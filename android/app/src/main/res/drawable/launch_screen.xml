<?xml version="1.0" encoding="utf-8"?>
<!-- Launch wiring: the ember centred on the scheme's `bg` (`launch_background` resolves from
     values-night/ in dark mode), Theme.Whim.Launch's windowBackground below Android 12. The
     256 dp mark draws the ember at 128 dp, its launch size (docs/design/system.md §3.3).
     values-v31 uses the system splash screen instead and never reads this drawable. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/launch_background" />
    <item
        android:width="256dp"
        android:height="256dp"
        android:gravity="center"
        android:drawable="@drawable/launch_mark" />
</layer-list>
