<?xml version="1.0" encoding="utf-8"?>
<!--
  The store build's network security config (design D5): cleartext to no host. The dev cleartext
  hosts live in src/debug/res/xml/network_security_config.xml, which replaces this whole file in
  the `debug` and `offline` build types (same resource name; see android/app/build.gradle).
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false"/>
</network-security-config>
