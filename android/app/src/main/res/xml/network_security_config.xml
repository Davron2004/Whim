<?xml version="1.0" encoding="utf-8"?>
<!--
  The network security config of every build type (beta-1 design D20, amending D5): cleartext is
  permitted at the base so a user's own server on their network (an arbitrary LAN IP, which a
  <domain> can't name) is reachable over http. The launcher's address rule
  (src/host/launcher/server-address.ts) is the guard: it accepts http:// only for a loopback or
  private-range IP literal (loopback, RFC 1918, link-local, IPv6 unique-local, carrier-grade NAT),
  localhost, a .local name or a single-label host that isn't numeric, and sends nothing to any
  other http:// address. Mini-app bundles stay off the network through the sandbox's CSP, whatever
  this file says.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true"/>
</network-security-config>
