{
  "name": "Whim",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "contract",
    "server"
  ],
  "scripts": {
    "android": "node scripts/android-dev.mjs",
    "android:release": "node scripts/android-release.mjs",
    "start": "react-native start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && node scripts/typecheck-tests.mjs",
    "build": "node build/build.mjs",
    "tokens": "node scripts/design-tokens.mjs",
    "vstore:test": "node src/host/version-store/test/run.mjs",
    "storage:test": "node src/host/storage-engine/test/run.mjs",
    "bridge:test": "node src/host/bridge/test/run.mjs",
    "launcher:test": "node src/host/launcher/test/run.mjs",
    "launcher:deliver-verify": "node src/host/launcher/test/deliver-by-source.desktop.mjs",
    "sdk:motion-verify": "node src/sdk/test/motion.desktop.mjs",
    "sdk:test": "node src/sdk/test/run.mjs",
    "checks:test": "node checks/test/run.mjs",
    "synthrun:test": "node synthrun/test/run.mjs",
    "evals:test": "node evals/test/run.mjs",
    "evals": "node evals/cli.mjs",
    "invariants": "node invariants/sandbox-isolation/run-against-build.mjs",
    "bridge:invariants": "node invariants/sandbox-isolation/bridge/runner.mjs",
    "server:dev": "node --env-file-if-exists=.env server/dev.mjs",
    "server:test": "node server/test/run.mjs",
    "server:e2e": "node server/test/e2e.run.mjs",
    "guard:metro": "node server/guard-metro.mjs",
    "stores:firestore:test": "node scripts/firestore-emulator-test.mjs",
    "whim:logs": "node server/logs-tail.mjs",
    "deps:audit": "node scripts/deps-audit.mjs"
  },
  "dependencies": {
    "@op-engineering/op-sqlite": "^19.0.5",
    "buffer": "^6.0.3",
    "crc-32": "^1.2.2",
    "isomorphic-git": "1.44.18",
    "react": "19.3.1",
    "react-error-boundary": "6.1.6",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "3.5.0",
    "react-native-keyboard-controller": "1.23.1",
    "react-native-logs": "5.6.0",
    "react-native-mmkv": "^4.3.2",
    "react-native-nitro-modules": "^0.37.2",
    "react-native-reanimated": "4.8.0",
    "react-native-safe-area-context": "^5.11.1",
    "react-native-screens": "4.30.1",
    "react-native-svg": "15.16.1",
    "react-native-webview": "^14.0.1",
    "react-native-worklets": "0.14.0",
    "sha.js": "^2.4.12",
    "text-encoding-polyfill": "^0.6.7"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/runtime": "^7.25.0",
    "@fission-ai/openspec": "^1.4.1",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native/babel-preset": "0.88.1",
    "@react-native/eslint-config": "0.88.1",
    "@react-native/metro-config": "0.88.1",
    "@react-native/typescript-config": "0.88.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-test-renderer": "^19.3.1",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-plugin-sonarjs": "^4.2.2",
    "firebase-tools": "15.37.0",
    "globals": "^17.14.0",
    "knip": "^6.47.0",
    "metro-symbolicate": "0.87.3",
    "playwright": "^1.65.1",
    "prettier": "3.10.1",
    "react-dom": "19.3.1",
    "react-test-renderer": "19.3.1",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=26"
  },
  "codegenConfig": {
    "name": "WhimAppSpecs",
    "type": "modules",
    "jsSrcsDir": "src/native",
    "android": {
      "javaPackageName": "com.whim.tone"
    },
    "ios": {
      "modulesProvider": {
        "WhimTone": "WhimToneModule",
        "WhimHaptics": "WhimHapticsModule"
      }
    }
  },
  "overrides": {
    "@react-native/eslint-config": {
      "eslint-plugin-ft-flow": "^3.0.11"
    },
    "basic-ftp": "^6.2.2",
    "firebase-tools": {
      "gaxios": {
        "uuid": "^11.1.1"
      }
    }
  }
}
