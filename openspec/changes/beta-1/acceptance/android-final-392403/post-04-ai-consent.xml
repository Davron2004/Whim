x="0" text="" resource-id="" class="android.widget.Button" package="com.anycognition.whim" content-desc="Continuer en français" checkable="false" checked="false" clickable="true" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[829,261][1278,338]" drawing-order="1" hint=""><node index="0" text="Continuer en français" resource-id="" class="android.widget.TextView" package="com.anycognition.whim" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[829,261][1278,338]" drawing-order="1" hint="" /></node><node index="1" text="Before Whim builds apps for you" resource-id="" class="android.widget.TextView" package="com.anycognition.whim" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[66,386][1278,476]" drawing-order="2" hint="" /><node index="2" text="To build or change an app, Whim sends what you ask for to our server. AI companies that work for us write the code." resource-id="" class="android.widget.TextView" package="com.anycognition.whim" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[66,512][1278,638]" drawing-order="3" hint="" /><node index="3" text="WHAT GETS SENT" resource-id="" class="android.widget.TextView" package="com.anycognition.whim" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[66,704][1278,742]" drawing-order="4" hint="" /><node index="4" text="•" resource-id="" class