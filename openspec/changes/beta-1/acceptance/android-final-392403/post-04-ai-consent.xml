rce-id="" class="android.widget.TextView" package="com.anycognition.whim" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[114,1090][1278,1216]" drawing-order="10" hint="" /><node index="10" text="•" resource-id="" class="android.widget.TextView" package="com.anycognition.whim" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[66,1240][114,1366]" drawing-order="11" hint="" /><node index="11" text="Error details when something goes wrong. They’re technical only, not what you typed or saved." resource-id="" class="android.widget.TextView" package="com.anycognition.whim" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[114,1240][1278,1366]" drawing-order="12" hint="" /><node index="12" text="WHY" resource-id="" class="android.widget.TextView" package="com.anycognition.whim" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[66,1432][1278,1470]" drawing-order="13" hint="" /><node index="13" text="To build your apps and run Whim: daily limits, stopping abuse, keeping costs in check, and finding and fixing problems." resource-id="" class="android.widget.TextView" package="com.anycognition.whim" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[66,1518][1278,1644]" drawing-order="14" hint="" /><node index="14" text="WHO GETS IT" resource-id="" class="android.widget.TextView" package="com.anycognition.whim" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[66,1710][1278,1748]" drawing-order="15" hint="" /><node index="15" text="AnyCognition, the company that makes Whim, and companies that do work for us, like cloud hosting and AI providers. Some of them are outside Canada. They can’t train AI on it or use it for their own products, though some may keep it for a short time for security and legal reasons. Apple or Google may also check that requests come from the real Whim app. We give information to authorities when the law requires it." resource-id="" class="android.widget.TextView" package="com.anycognition.whim" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[66,1795][1278,2236]" drawing-order="16" hint="" /><node index="16" text="WHAT YOU SAVE IN YOUR APPS" resource-id="" class="android.widget.TextView" package="com.anycognition.whim" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[66,2302][1278,2340]" drawing-order="17" hint="" /><node index="17" text="Nobody at Whim can read it. Whim doesn’t send it anywhere, and anything Whim ever syncs or backs up for you is encrypted on your phone with a key Whim never has." resource-id="" class="android.widget.TextView" package="com.anycognition.whim" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[66,2389][1278,2524]" drawing-order="18" hint="" /><node index="18" text="WHAT WE NEVER DO" resource-id="" class="android.widget.TextView" package="com.anycognition.whim" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[66,2644][1278,2524]" drawing-order="19" hint="" /><node index="19" text="Show ads, sell your data or share it for advertising, or track you across other apps and websites." resource-id="" class="android.widget.TextView" package="com.anycognition.whim" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[66,2730][1278,2524]" drawing-order="20" hint="" /><node index="20" text="If we ever want to collect a new kind of information, use it for a new purpose, keep it longer, or give it to a new kind of company, we’ll ask you first." resource-id="" class="android.widget.TextView" package="com.anycognition.whim" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[66,2922][1278,2524]" drawing-order="21" hint="" /></node></node><node index="2" text="" resource-id="" class="android.widget.Button" package="com.anycognition.whim" content-desc="Agree and continue" checkable="false" checked="false" clickable="true" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[66,2560][1278,2716]" drawing-order="3" hint=""><node index="0" text="Agree and continue" resource-id="" class="android.widget.TextView" package="com.anycognition.whim" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" p