ead ten pages',\\n  'Call someone you like',\\n  'Put the laundry on',\\n  'Check the calendar for tomorrow',\\n  'Take out the recycling',\\n  'Write down one good thing',\\n  'Charge your phone',\\n  'Lay out clothes for tomorrow',\\n];\\n\\nfunction Today() {\\n  const [tasks, setTasks] = useState(STARTERS.map((title, id) => ({ id, title, done: false })));\\n  const [draft, setDraft] = useState('');\\n  const [nextId, setNextId] = useState(STARTERS.length);\\n  const done = tasks.filter((task) => task.done).length;\\n\\n  const add = () => {\\n    const title = draft.trim();\\n    if (title === '') return;\\n    setTasks([...tasks, { id: nextId, title, done: false }]);\\n    setNextId(nextId + 1);\\n    setDraft('');\\n  };\\n  const tick = (id: number, checked: boolean) => {\\n    setTasks(tasks.map((task) => (task.id === id ? { ...task, done: checked } : task)));\\n  };\\n\\n  return (\\n    <Screen padding=\\\"lg\\\">\\n      <Stack gap=\\\"lg\\\">\\n        <Heading size=\\\"title\\\">Today</Heading>\\n        <Text color=\\\"text-muted\\\">{done + ' of ' + tasks.length + ' done'}</Text>\\n        <ProgressBar value={tasks.length === 0 ? 0 : done / tasks.length} tone=\\\"positive\\\" />\\n        <Row gap=\\\"sm\\\" align=\\\"center\\\">\\n          <TextInput value={draft} placeholder=\\\"Add a task\\\" onChange={setDraft} />\\n          <Button label=\\\"Add\\\" disabled={draft.trim() === ''} onPress={add} />\\n        </Row>\\n        <Stack gap=\\\"sm\\\">\\n          {tasks.map((task) => (\\n            <Checkbox key={task.id} label={task.title} checked={task.done} onChange={(checked) => tick(task.id, checked)} />\\n          ))}\\n        </Stack>\\n        <Button label=\\\"Clear done\\\" variant=\\\"secondary\\\" disabled={done === 0} onPress={() => setTasks(tasks.filter((task) => !task.done))} />\\n      </Stack>\\n    </Screen>\\n  );\\n}\\n\\nexport default defineApp({ name: 'Hello App', initial: 'Today', screens: { Today }, capabilities: [] });\\n\", \"// esbuild `inject` shim for the app-bundle build: provides the `React` binding the classic\\n// JSX transform (`React.createElement`) needs, resolved from the EXTERNAL `react` (\\u2192 the host-\\n// injected `window.React` at runtime via H1b). The fixture imports only from `vc-sdk` and\\n// never names React itself; this makes its compiled `React.createElement(...)` calls resolve\\n// to the one shared instance without bundling a second copy of React into the app.\\nimport * as React from 'react';\\nexport { React };\\n\"],\n  \"mappings\": \";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;AAAA;AAAA;AAAA;AAAA;;;ACKA,cAAuB;;;ADLvB,sBAAiH;AAEjH,MAAM,WAAW;AAAA,IACf;AAAA,IACA;AAAA,IACA;AAAA,IACA;AAAA,IACA;AAAA,IACA;AAAA,IACA;AAAA,IACA;AAAA,IACA;AAAA,IACA;AAAA,IACA;AAAA,IACA;AAAA,IACA;AAAA,IACA;AAAA,IACA;AAAA,IACA;AAAA,EACF;AAEA,WAAS,QAAQ;AACf,UAAM,CAAC,OAAO,QAAQ,QAAI,wBAAS,SAAS,IAAI,CAAC,OAAO,QAAQ,EAAE,IAAI,OAAO,MAAM,MAAM,EAAE,CAAC;AAC5F,UAAM,CAAC,OAAO,QAAQ,QAAI,wBAAS,EAAE;AACrC,UAAM,CAAC,QAAQ,SAAS,QAAI,wBAAS,SAAS,MAAM;AACpD,UAAM,OAAO,MAAM,OAAO,CAAC,SAAS,KAAK,IAAI,EAAE;AAE/C,UAAM,MAAM,MAAM;AAChB,YAAM,QAAQ,MAAM,KAAK;AACzB,UAAI,UAAU,GAAI;AAClB,eAAS,CAAC,GAAG,OAAO,EAAE,IAAI,QAAQ,OAAO,MAAM,MAAM,CAAC,CAAC;AACvD,gBAAU,SAAS,CAAC;AACpB,eAAS,EAAE;AAAA,IACb;AACA,UAAM,OAAO,CAAC,IAAY,YAAqB;AAC7C,eAAS,MAAM,IAAI,CAAC,SAAU,KAAK,OAAO,KAAK,EAAE,GAAG,MAAM,MAAM,QAAQ,IAAI,IAAK,CAAC;AAAA,IACpF;AAEA,WACE,oCAAC,wBAAO,SAAQ,QACd,oCAAC,uBAAM,KAAI,QACT,oCAAC,yBAAQ,MAAK,WAAQ,OAAK,GAC3B,oCAAC,sBAAK,OAAM,gBAAc,OAAO,SAAS,MAAM,SAAS,OAAQ,GACjE,oCAAC,6BAAY,OAAO,MAAM,WAAW,IAAI,IAAI,OAAO,MAAM,QAAQ,MAAK,YAAW,GAClF,oCAAC,qBAAI,KAAI,MAAK,OAAM,YAClB,oCAAC,2BAAU,OAAO,OAAO,aAAY,cAAa,UAAU,UAAU,GACtE,oCAAC,wBAAO,OAAM,OAAM,UAAU,MAAM,KAAK,MAAM,IAAI,SAAS,KAAK,CACnE,GACA,oCAAC,uBAAM,KAAI,QACR,MAAM,IAAI,CAAC,SACV,oCAAC,0BAAS,KAAK,KAAK,IAAI,OAAO,KAAK,OAAO,SAAS,KAAK,MAAM,UAAU,CAAC,YAAY,KAAK,KAAK,IAAI,OAAO,GAAG,CAC/G,CACH,GACA,oCAAC,wBAAO,OAAM,cAAa,SAAQ,aAAY,UAAU,SAAS,GAAG,SAAS,MAAM,SAAS,MAAM,OAAO,CAAC,SAAS,CAAC,KAAK,IAAI,CA